{
  "manifest_version": 3,
  "name": "coincell",
  "version": "0.13.22",
  "description": "Sends your balances, holdings and transactions from sites you are logged in to, to coincell running on this computer.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["scripting", "tabs", "storage", "alarms"],
  "host_permissions": ["http://localhost/*"],
  "optional_host_permissions": ["https://*/*"]
}
